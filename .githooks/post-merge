#!/bin/sh
# ---------------------------------------------------------------------------
# .githooks/post-merge — 合并/拉取后提示需要手动做的动作
# 只提示，不阻断（post-* hook 的退出码不影响操作结果）
# ---------------------------------------------------------------------------

# 1) 依赖或构建配置变化 → 需要重新安装依赖
changed=$(git diff --name-only ORIG_HEAD HEAD -- \
            oh-package.json5 oh-package-lock.json5 build-profile.json5 2>/dev/null || true)
if [ -n "$changed" ]; then
  echo ""
  echo "⚠ 依赖或构建配置发生变化，建议执行: ohpm install"
  printf '%s\n' "$changed" | sed 's/^/    /'
fi

# 2) 上游同步记录变化 → 提醒核对 RN 侧是否仍与上游一致
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^docs/UPSTREAM-SYNC.md'; then
  echo ""
  echo "⚠ 上游同步记录有更新 → 请查阅 docs/UPSTREAM-SYNC.md"
  echo "   RN 侧已冻结，核对 src/ 是否仍与 upstream/main 一致（应为 141/141）"
fi

exit 0
