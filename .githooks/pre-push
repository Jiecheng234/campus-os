#!/bin/sh
# ---------------------------------------------------------------------------
# .githooks/pre-push — 推送前门禁
#
# 【唯一硬门禁】devecocli build（在 harmony/ 内执行 —— 它不是仓库根！）
#   实测 exit code 可靠、增量构建约 18s
#
# 【只提示不阻断】devecocli check arkts
#   当前有 6 个既有 error（PlatformBridge 的 as const / 无类型字面量、
#   WebvpnTransport 参数个数等）+ 1 个已知误报（Logger 的 BuildProfile），
#   直接做成硬门禁会立刻堵死所有推送。
#
# 【为什么不把 check lint 放进来】
#   实测即使报告 Error 级问题（CryptoUtils 的不安全 hash/AES）也返回 exit 0，
#   且耗时 41s —— 既不能当门禁，又拖慢每次推送。留给定期检查/CI。
#
# 跳过: SKIP_VERIFY=1 git push
# 自定义 CLI: DEVECO_CLI="node /path/to/cli.js" git push
# ---------------------------------------------------------------------------
if [ "${SKIP_VERIFY:-}" = "1" ]; then
  echo "⚠ SKIP_VERIFY=1 → 跳过 pre-push 校验"
  exit 0
fi

# 只在推送触及 harmony/ 时校验
base=$(git merge-base HEAD '@{upstream}' 2>/dev/null || echo 'HEAD~1')
if ! git diff --name-only "$base" HEAD 2>/dev/null | grep -q '^harmony/'; then
  echo "→ 本次推送未触及 harmony/，跳过校验"
  exit 0
fi

# 鸿蒙工程根 = 仓库根/harmony（devecocli 必须在工程根执行）
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
proj="$top/harmony"
if [ ! -f "$proj/build-profile.json5" ]; then
  echo "⚠ 未找到 $proj/build-profile.json5 → 跳过校验"
  exit 0
fi

# ---- 定位 devecocli：PATH → DEVECO_CLI → npm 全局包 ----
CLI=""
if command -v devecocli >/dev/null 2>&1; then
  CLI="devecocli"
elif [ -n "${DEVECO_CLI:-}" ]; then
  CLI="$DEVECO_CLI"
elif command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
  root=$(npm root -g 2>/dev/null | tr -d '\r' | tr '\\' '/')
  shim="$root/@deveco/deveco-code/node_modules/@deveco/deveco-cli/cli.js"
  if [ -f "$shim" ]; then
    CLI="node $shim"
  fi
fi

if [ -z "$CLI" ]; then
  echo "⚠ 未找到 devecocli（PATH / DEVECO_CLI / npm 全局包均未命中）→ 跳过校验"
  echo "  可设置: DEVECO_CLI=\"node <npm-root>/@deveco/deveco-code/node_modules/@deveco/deveco-cli/cli.js\""
  exit 0
fi

echo "→ 工程目录: $proj"
cd "$proj" || { echo "✗ 无法进入 $proj"; exit 1; }

# 注意: $CLI 故意不加引号 —— 需按空格分词以支持 "node /path/cli.js"
# shellcheck disable=SC2086
echo "→ [门禁] build --modules entry --build-mode debug"
# shellcheck disable=SC2086
if ! $CLI build --modules entry --build-mode debug; then
  echo ""
  echo "✗ 构建未通过，已阻止推送"
  echo "  修好后重试；确需紧急推送: SKIP_VERIFY=1 git push"
  exit 1
fi

# ---- 提示项：ArkTS 静态检查（永不阻断） ----
# shellcheck disable=SC2086
if $CLI check arkts >/dev/null 2>&1; then
  echo "✓ check arkts 通过"
else
  echo "⚠ check arkts 报告问题（不阻断）—— 当前有 6 个既有 error + BuildProfile 已知误报"
  echo "  查看详情: (cd harmony && $CLI check arkts)"
fi

echo "✓ pre-push 校验通过"
exit 0
