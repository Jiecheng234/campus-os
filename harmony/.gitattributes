# ─────────────────────────────────────────────────────────────────────────────
# 换行与编码治理 —— 本文件**只作用于 harmony/ 子树**
#
# 背景：Windows 下 core.autocrlf=true 会在 checkout 时把 LF 改写为 CRLF，
#       导致 git add 刷警告、跨平台比对出现整文件 diff、上游合并放大冲突。
#
# 为什么放在 harmony/ 而不是仓库根：
#   本仓库是上游 RN 项目的 fork。根级 .gitattributes 会改变上游/协作者的
#   checkout 行为（他们没同意这个约定）。这里只固定我们新增的鸿蒙代码，
#   对 src/、android/ 等上游文件保持 autocrlf 默认行为。
#   作用域验证：git check-attr text eol -- harmony/.../Index.ets   → text, lf
#               git check-attr text eol -- src/polyfills.ts        → unspecified
# ─────────────────────────────────────────────────────────────────────────────

* text=auto eol=lf

# ArkTS / 前端 / 配置 / 文档
*.ets    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.json5  text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.sh     text eol=lf

*.gitignore      text eol=lf
*.gitattributes  text eol=lf

# Windows 脚本保持 CRLF，避免 PowerShell 解析异常
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# ohpm 每次构建会用它自己的换行（Windows 下 CRLF）重写这个锁文件。
# 若这里强制 LF，每次 devecocli build 后都会出现"已修改但 diff 为空"的假脏状态。
# 约定：仓库内仍存 LF，工作区保持 ohpm 写入的 CRLF → git status 保持干净。
oh-package-lock.json5  text eol=crlf

# 二进制：禁止换行转换与文本 diff
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.so     binary
*.a      binary
*.dylib  binary
*.har    binary
*.hap    binary
*.hsp    binary
*.app    binary
*.apk    binary
*.aab    binary
*.keystore binary
*.p12    binary
*.p7b    binary
*.cer    binary
